# ── Docker Compose environment ─────────────────────────────────────────────
# Copy to `.env` before running `docker compose up`.
# These values configure the MySQL container and are consumed by
# docker-compose.yml. The server container derives DATABASE_URL from them.

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=nexarch
MYSQL_USER=nexarch
MYSQL_PASSWORD=change-me

# Server secrets (generate with: openssl rand -base64 48)
JWT_SECRET=

# Published host ports
SERVER_PORT=4000
CLIENT_PORT=8080
MYSQL_PORT=3306
