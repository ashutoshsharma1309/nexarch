# ── Docker Compose environment ─────────────────────────────────────────────
# Copy to `.env` before running `docker compose up`.
# These values configure the PostgreSQL container and are consumed by
# docker-compose.yml. The server container derives DATABASE_URL from them.

POSTGRES_DB=nexarch
POSTGRES_USER=nexarch
POSTGRES_PASSWORD=change-me

# Point the API at a managed Postgres (e.g. Supabase) instead of the bundled
# container. When set, this wins over the values above.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# AI provider — the key stays in the API container, never in the client.
AI_PROVIDER=groq
AI_API_KEY=

# Login is off by default. For real accounts set AUTH_DISABLED=false and a
# JWT_SECRET (generate with: openssl rand -base64 48).
AUTH_DISABLED=true
JWT_SECRET=

# Published host ports
SERVER_PORT=4000
CLIENT_PORT=8080
POSTGRES_PORT=5432
