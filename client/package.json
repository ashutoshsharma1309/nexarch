{
  "name": "@nexarch/client",
  "version": "0.1.0",
  "private": true,
  "description": "NexArch console \u2014 React client for the generation platform",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "//test:coverage": "The raised timeout is for the instrumented run only: v8 coverage adds\nenough per-call overhead that the userEvent tests (fine in ~2s under `npm test`) blow past the\n5s default and fail as timeouts, which would make the coverage number unobtainable.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --testTimeout=30000",
    "typecheck": "tsc -b --force",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@hookform/resolvers": "^5.0.1",
    "@tanstack/react-query": "^5.75.0",
    "@xyflow/react": "^12.11.5",
    "axios": "^1.9.0",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "framer-motion": "^12.9.0",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.0",
    "react-router-dom": "^7.5.0",
    "tailwind-merge": "^3.2.0",
    "zod": "^3.25.0",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.5",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dagre": "^0.7.54",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.5",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.31.0",
    "vite": "^6.3.0",
    "vitest": "4.1.10"
  },
  "//devDependencies": "vitest and @vitest/coverage-v8 are pinned exactly and must move together: the coverage provider declares an exact peer on vitest (4.1.10, not ^4.1.10), so a caret lets npm consider providers whose peer contradicts the installed vitest \u2014 which does not resolve, it crashes the installer outright."
}
