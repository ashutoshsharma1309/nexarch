// NexArch — foundation schema (Phase 1).
//
// Only the entities the platform itself needs to exist are modeled here:
// who uses it (User/Role), what they own (Project), and the audit trail of
// generation runs (Generation). Business logic, credentials flows, and the
// dependency-graph tables arrive with their phases — the schema stays ahead
// of the code by exactly one step, never more.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Assignable authorization role. Kept as a table (not an enum) so roles can
/// gain metadata (permissions JSON, descriptions) without a migration dance.
model Role {
  id          String   @id @default(cuid())
  name        String   @unique @db.VarChar(64)
  description String?  @db.VarChar(255)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique @db.VarChar(320)
  /// bcrypt hash — never the raw password. Nullable so seed/staging users
  /// can exist without fake credentials; a null hash simply cannot log in,
  /// failing the same way a wrong password does.
  passwordHash String?   @map("password_hash") @db.VarChar(100)
  name         String    @db.VarChar(120)
  /// When the user finished the onboarding flow. Null until they do; the
  /// welcome experience shows only while this is null.
  onboardedAt  DateTime? @map("onboarded_at")
  role         Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  roleId       String    @map("role_id")
  projects     Project[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([roleId])
  @@map("users")
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// A user-owned workspace for one generated application. The prompt that
/// created it and every regeneration live in `generations`.
model Project {
  id           String        @id @default(cuid())
  name         String        @db.VarChar(120)
  slug         String        @db.VarChar(140)
  description  String?       @db.Text
  status       ProjectStatus @default(DRAFT)
  /// Pinned in the project list. Presentation state, but it belongs to the
  /// row rather than the browser — a pin should survive a different device.
  favorite     Boolean       @default(false)
  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId      String        @map("owner_id")
  generations  Generation[]
  graphNodes   GraphNode[]
  graphEdges   GraphEdge[]
  runArtifacts RunArtifact[]
  editJobs     EditJob[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  /// Scoped per owner, not globally: two users naming a project "Storefront"
  /// is normal, and a global unique slug would make the second one fail.
  @@unique([ownerId, slug])
  @@index([ownerId])
  @@map("projects")
}

enum GenerationStatus {
  PENDING
  ANALYZING
  PLANNING
  GENERATING
  REVIEWING
  COMPLETED
  FAILED
}

/// One run of the generation pipeline. Statuses mirror the pipeline stages
/// (analyze → plan → generate → review) so progress can be streamed to the
/// client and failed runs can be resumed at the stage that broke.
model Generation {
  id          String           @id @default(cuid())
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String           @map("project_id")
  prompt      String           @db.Text
  status      GenerationStatus @default(PENDING)
  /// Structured failure detail when status = FAILED.
  error       String?          @db.Text
  startedAt   DateTime?        @map("started_at")
  completedAt DateTime?        @map("completed_at")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([projectId, createdAt])
  @@map("generations")
}

/// What a run actually produced.
///
/// Until this table existed, generated code lived only in a Map inside the
/// API process: the `generations` row recorded that a build happened while
/// the build itself evaporated on the next restart. Every project then
/// showed a completed run whose Code tab, Preview and editor had nothing to
/// read, and the knowledge graph — which *is* persisted — kept pointing at
/// files no longer anywhere.
///
/// One row per run, holding the whole bundle as JSON. The reads are
/// whole-bundle by nature (the Code tab lists every file, the runner writes
/// every file, an edit regenerates from the same inputs), so splitting it
/// across tables would buy nothing and cost a join. Postgres stores a value
/// this size out of line automatically.
model RunArtifact {
  /// The run this is the output of. One bundle per run, so the id is the key.
  runId     String   @id @map("run_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String   @map("project_id")
  /// Lets a later shape change recognise and skip bundles it cannot read.
  version   Int      @default(1)
  /// The PipelineArtifacts bundle: spec, plans, generated files, design.
  payload   Json
  /// Denormalised so a listing can show size without loading the payload.
  fileCount Int      @map("file_count")
  bytes     Int
  createdAt DateTime @default(now()) @map("created_at")

  @@index([projectId, createdAt])
  @@map("run_artifacts")
}

/// The lifecycle of one applied edit.
///
/// Applying an edit is five to six minutes of real work — it installs, builds,
/// type-checks, lints and boots the edited project before accepting it — and
/// it used to run inside a single HTTP request. That made the client's
/// timeout a race the user could lose: the request failed while the server
/// went on to apply the edit, so the next edit started from a project the
/// user believed unchanged. Closing the tab had the same effect.
///
/// So the work outlives the request, and this row is what the client polls.
/// It is durable for one specific reason: a restart mid-edit must be
/// reportable as an interruption rather than silently forgotten or, worse,
/// read as success.
enum EditJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  /// The edit ran and was refused: validation failed, so the project kept its
  /// previous files. Distinct from FAILED, which means the attempt broke.
  REJECTED
  FAILED
  /// The process died while this job was running. Nothing can be assumed
  /// about how far it got.
  INTERRUPTED
}

model EditJob {
  id          String        @id @default(cuid())
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String        @map("project_id")
  /// Who may read it. Plans live in memory keyed by owner; this outlives them.
  ownerId     String        @map("owner_id")
  /// The in-memory plan this came from, for correlating logs after the fact.
  planId      String        @map("plan_id")
  status      EditJobStatus @default(QUEUED)
  /// The stage now in progress — a real step, never a percentage.
  stage       String
  /// Every stage with its own start and end, so elapsed time is measured.
  stages      Json
  /// What the user asked for, shown while the job runs.
  instruction String        @db.Text
  /// The EditResult once terminal: checks, changed files, outcome.
  result      Json?
  /// User-facing failure text. Never a stack trace, never a secret.
  error       String?       @db.Text
  /// The run this produced, when it was accepted.
  runId       String?       @map("run_id")
  startedAt   DateTime?     @map("started_at")
  completedAt DateTime?     @map("completed_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([projectId, createdAt])
  @@index([status])
  /// A partial unique index on (project_id) WHERE status IN ('QUEUED','RUNNING')
  /// enforces one active edit per project. Prisma cannot express a partial
  /// index, so it lives in the migration — see
  /// 20261024150000_one_active_edit_per_project. Without it the service's
  /// check-then-create is a race a double-click wins.
  @@map("edit_jobs")
}

/// ── Engineering Graph ──────────────────────────────────────────────────
///
/// The project's structured knowledge: what was asked for, what was
/// planned, what was generated, and how it all connects. Stored
/// relationally rather than in a graph database because the shape here is
/// small (hundreds of nodes per project, not millions) and bounded
/// traversal over two indexed tables is faster than operating a second
/// datastore would be worth.
///
/// Both tables cascade from `Project`: a graph is meaningless without the
/// project it describes, and leaving orphaned nodes behind would slowly
/// poison every query that filters by project.

enum GraphNodeType {
  PROJECT
  REQUIREMENT
  FEATURE
  COMPONENT
  SERVICE
  API
  ENTITY
  FIELD
  FILE
  FOLDER
  MODULE
  SECURITY_RULE
  DEPENDENCY
  TEST
  FINDING
}

enum GraphRelationship {
  CONTAINS
  IMPLEMENTS
  DEPENDS_ON
  USES
  CALLS
  EXPOSES
  PERSISTS
  BELONGS_TO
  GENERATES
  VALIDATES
  TESTS
  SECURED_BY
  TARGETS
}

model GraphNode {
  id               String        @id @default(cuid())
  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId        String        @map("project_id")
  /// The run that last produced or refreshed this node. Not a foreign key:
  /// a node outlives the run that created it (the next run refreshes it in
  /// place), so a deleted generation row must not take the node with it.
  runId            String        @map("run_id")
  type             GraphNodeType
  /// Stable identity within (project, type). Two artifacts naming the same
  /// thing differently resolve to one node through this column.
  canonicalName    String        @map("canonical_name") @db.VarChar(255)
  name             String        @db.VarChar(255)
  description      String?       @db.Text
  metadata         Json
  /// The artifact type this node was derived from — the trace back to source.
  sourceArtifactId String?       @map("source_artifact_id") @db.VarChar(64)

  outgoing GraphEdge[] @relation("edgeSource")
  incoming GraphEdge[] @relation("edgeTarget")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The deduplication guarantee: one node per canonical name per type.
  @@unique([projectId, type, canonicalName])
  @@index([projectId, type])
  @@index([runId])
  @@map("graph_nodes")
}

model GraphEdge {
  id        String  @id @default(cuid())
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String  @map("project_id")
  runId     String  @map("run_id")

  source       GraphNode @relation("edgeSource", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  sourceNodeId String    @map("source_node_id")
  target       GraphNode @relation("edgeTarget", fields: [targetNodeId], references: [id], onDelete: Cascade)
  targetNodeId String    @map("target_node_id")

  relationship GraphRelationship
  metadata     Json

  createdAt DateTime @default(now())

  /// One edge per (source, target, relationship). Re-running the builder
  /// re-asserts the same edges; this is what makes that idempotent.
  @@unique([sourceNodeId, targetNodeId, relationship])
  @@index([projectId, sourceNodeId])
  @@index([projectId, targetNodeId])
  @@map("graph_edges")
}
