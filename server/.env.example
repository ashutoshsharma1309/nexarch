# ── NexArch API environment ───────────────────────────────────────────────
# Copy to `.env` and adjust. Every variable is validated at boot by
# src/shared/config/env.ts — the process refuses to start on invalid config.

# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Database (PostgreSQL via Prisma — Supabase or any Postgres) — OPTIONAL.
# Leave it unset (or commented) to run with NO database: projects, the
# engineering graph and run history live in memory and reset on restart.
# Set it to a postgresql:// string to switch on real persistence.
#
# Supabase: Project Settings → Database → Connection string → URI. Use the
# direct connection (port 5432) so `prisma migrate deploy` can run; the
# transaction pooler (6543) does not support the statements migrations need.
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
#
# Local Postgres instead:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexarch"

# Authentication — OFF by default for local use. With AUTH_DISABLED=true there
# is no login or signup: every request runs as a single built-in local admin.
# Two limits apply: the server refuses to start with it when NODE_ENV=production,
# and in any other mode it answers only requests from this machine. Set it to
# false to turn real accounts back on (which then requires a real JWT_SECRET).
AUTH_DISABLED=true

# Sign-in inside the apps NexArch generates. false (default): every generated
# project is a public MVP — no login/register pages, no guarded routes.
# true: plan an Authentication module, login pages and route guards into it.
GENERATED_APP_AUTH=false

# CORS — comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# Rate limiting (per IP, per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Auth secret — only needed when AUTH_DISABLED=false. Generate a real one
# with: openssl rand -base64 48  (min 32 chars).
# JWT_SECRET=dev-only-secret-change-me-please-0000000000000000
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── AI provider ───────────────────────────────────────────────────────────
# The key is read server-side only and never leaves the API process. The
# platform boots without it and every AI stage degrades to its deterministic
# fallback, so a missing key is a downgrade, not an outage.
#
# AI_PROVIDER: groq | claude | openai | gemini | openrouter | cerebras | mock
AI_PROVIDER=groq
AI_API_KEY=
# Tried when the primary provider has no key configured.
AI_FALLBACK_PROVIDER=claude
# Where planning and design start, when that should differ from AI_PROVIDER.
# AI_PROVIDER_DEEP=gemini
# Failover order after the first provider, comma-separated. Providers with no
# key are skipped. When set, this replaces AI_FALLBACK_PROVIDER.
# AI_PROVIDER_CHAIN=gemini,openrouter
# Per-job spend limits. A job that reaches either one stops with an error that
# names it, so a loop cannot run up a bill. Defaults shown.
# AI_JOB_TOKEN_CEILING=1500000
# AI_JOB_CALL_CEILING=150
# Ceiling on one request's context + output tokens, matched to the
# provider tier. Groq's free tier allows 8000 per minute and counts the
# output allowance toward it before generating. Default: 32000.
# AI_MAX_REQUEST_TOKENS=8000

# Optional per-tier model overrides (defaults shown are the Groq ones).
AI_MODEL_FAST=openai/gpt-oss-20b
AI_MODEL_DEEP=openai/gpt-oss-120b
# One provider's tier, which wins over the two above. Ids retire, so these
# are the first thing to change when a provider starts returning 404.
# AI_MODEL_GEMINI_DEEP=
# AI_MODEL_OPENROUTER_DEEP=
# Only GROQ_API_KEY wins over AI_API_KEY; each other provider reads its own
# key alone. An empty value counts as unset.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
# Which provider reasons over web research. Defaults to openrouter when
# OPENROUTER_API_KEY is set, then to the normal deep-tier chain.
# AI_PROVIDER_RESEARCH=openrouter

# ── Web research ──────────────────────────────────────────────────────────
# Both optional. With one, research continues on it and records what is
# missing; with neither, research reports itself unavailable and generation
# proceeds. Set WEB_RESEARCH_ENABLED=false to turn research off entirely.
# WEB_RESEARCH_ENABLED=true
# Reference sites are rendered in headless Chromium inside this server to measure
# layout, type and colour. Needs Playwright and its browser; without them research
# continues and says so. Set to false to never load third-party pages here.
# WEB_RESEARCH_RENDER_REFERENCES=true
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# ── Optional integrations ─────────────────────────────────────────────────
# Read at provider level, never required — the platform boots and runs
# fully without them; only the final execution step of each integration
# stays disabled until its token exists.

# One-click deploy providers — set only the ones you use.
# VERCEL_TOKEN=
# RAILWAY_TOKEN=
# RENDER_API_KEY=

# Local Run Engine: workspace root for one-click runs (default: OS tmp)
# and how many sessions may run at once (default: 2).
# NEXARCH_RUNNER_DIR=
# NEXARCH_RUNNER_MAX_SESSIONS=2
# How many `npm install`s may run at once (default 1). A preview and an agent
# review install the same project; one at a time keeps small machines out of
# swap and the second install hits a warm cache.
# NEXARCH_RUNNER_MAX_INSTALLS=1

# Give runner sessions a real database: a MySQL *server* URL whose user can
# CREATE DATABASE (each run gets its own nexarch_run_<project> schema).
# Without it, generated backends start in degraded mode (no DB).
# A least-privilege user needs both grants — `prisma db push` connects to the
# `mysql` schema before it creates the run database (P1010 otherwise):
#   GRANT ALL PRIVILEGES ON `nexarch\_run\_%`.* TO 'runner'@'127.0.0.1';
#   GRANT SELECT ON mysql.time_zone_name TO 'runner'@'127.0.0.1';
# Example: mysql://runner:runner_local_dev@127.0.0.1:3307
# NEXARCH_RUNNER_DATABASE_URL=

# Most model tokens one verified-failure repair may spend (default 60000).
# NEXARCH_REPAIR_TOKEN_BUDGET=60000
